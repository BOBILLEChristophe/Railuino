{
  "name": "Railuino",
  "version": "0.11.0",
  "description": "Control a Märklin layout through its CAN bus (Gleisbox, MS2, CS2) from an ESP32 or an Arduino with an MCP2515. Based on Railuino 0.9 by Joerg Pleumann.",
  "keywords": "marklin, maerklin, can, gleisbox, ms2, cs2, mfx, mm2, dcc, s88, model railway",
  "repository": {
    "type": "git",
    "url": "https://github.com/BOBILLEChristophe/Railuino.git"
  },
  "authors": [
    { "name": "Joerg Pleumann" },
    { "name": "Christophe Bobille", "maintainer": true },
    { "name": "Uwe Monreal" }
  ],
  "license": "LGPL-2.1-or-later",
  "frameworks": "arduino",
  "platforms": ["espressif32", "atmelavr"],
  "dependencies": [
    {
      "owner": "pierremolinaro",
      "name": "ACAN_ESP32",
      "version": "^3.0.3",
      "platforms": ["espressif32"]
    },
    {
      "owner": "pierremolinaro",
      "name": "ACAN2515",
      "version": "^2.1.3",
      "platforms": ["atmelavr"]
    }
  ],
  "export": {
    "exclude": [".vscode", ".pio", "extras/archive"]
  }
}
